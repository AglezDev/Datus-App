<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/exchange_rates_widget_root"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/widget_background_rounded"
    android:gravity="center_vertical">

    <!-- Exchange Rates Container (taking most of the space) -->
    <LinearLayout
        android:id="@+id/widget_rates_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginEnd="4dp"
        android:weightSum="3">

        <!-- USD Rate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="1dp">

            <TextView
                android:id="@+id/usd_currency_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USD"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_color" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/usd_rate_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_color"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/usd_up_arrow"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@android:drawable/presence_online"
                    android:visibility="gone"/>
                <ImageView
                    android:id="@+id/usd_down_arrow"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@android:drawable/presence_busy"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- EUR Rate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="1dp">

            <TextView
                android:id="@+id/eur_currency_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EUR"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_color" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/eur_rate_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_color"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/eur_up_arrow"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@android:drawable/presence_online"
                    android:visibility="gone"/>
                <ImageView
                    android:id="@+id/eur_down_arrow"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@android:drawable/presence_busy"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- MLC Rate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="1dp">

            <TextView
                android:id="@+id/mlc_currency_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MLC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_color" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/mlc_rate_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_color"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/mlc_up_arrow"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@android:drawable/presence_online"
                    android:visibility="gone"/>
                <ImageView
                    android:id="@+id/mlc_down_arrow"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@android:drawable/presence_busy"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Text for loading state -->
    <TextView
        android:id="@+id/widget_loading_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:text="Actualizando..."
        android:textColor="@color/widget_text_color"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Refresh Button -->
    <ImageButton
        android:id="@+id/widget_refresh_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/cycle_24"
        android:background="@drawable/widget_refresh_button_background"
        android:contentDescription="Actualizar tasas" />

</LinearLayout>