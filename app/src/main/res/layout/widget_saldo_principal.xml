<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_saldo_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_saldo_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_saldo_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_data_usage"
            android:contentDescription="Saldo Principal"
            android:tint="@color/widget_icon_tint_light"
            android:padding="4dp"
            android:background="@drawable/widget_icon_background" />

        <TextView
            android:id="@+id/widget_saldo_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SALDO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_color"
            android:alpha="0.6" />

    </LinearLayout>

</FrameLayout>
